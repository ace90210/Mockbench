@page "/postman"

@layout FullscreenLayout

@rendermode InteractiveAuto
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory

<div class="flex flex-col min-h-screen bg-gray-900 text-gray-300 font-inter">


    <div class="flex flex-1 overflow-hidden">
        <aside class="w-1/5 bg-gray-800 p-0 flex flex-col border-r border-gray-700">
            <div class="flex border-b border-gray-700">
                <button @onclick="() => SwitchLeftSidebarTab(LeftSidebarTab.Microservices)"
                class="flex-1 p-3 text-sm font-medium hover:bg-gray-700 focus:outline-none @(ActiveLeftSidebarTab == LeftSidebarTab.Microservices ? "sidebar-tab-active" : "text-gray-400")">
                    Microservices
                </button>
                <button @onclick="() => SwitchLeftSidebarTab(LeftSidebarTab.Endpoints)"
                class="flex-1 p-3 text-sm font-medium hover:bg-gray-700 focus:outline-none @(ActiveLeftSidebarTab == LeftSidebarTab.Endpoints ? "sidebar-tab-active" : "text-gray-400")">
                    Endpoints
                </button>
            </div>

            @if (ActiveLeftSidebarTab == LeftSidebarTab.Microservices)
            {
                <div class="p-4 space-y-2 overflow-y-auto flex-1">
                    <div class="p-2 rounded hover:bg-gray-700 cursor-pointer text-sm text-gray-300">Auth Service</div>
                    <div class="p-2 rounded hover:bg-gray-700 cursor-pointer text-sm text-gray-300">User Service</div>
                    <div class="p-2 rounded hover:bg-gray-700 cursor-pointer text-sm text-gray-300">Product Service</div>
                </div>
            }
            @if (ActiveLeftSidebarTab == LeftSidebarTab.Endpoints)
            {
                <div class="p-4 space-y-1 overflow-y-auto flex-1">
                    <button @onclick="AddNewRequest" class="w-full bg-blue-500 hover:bg-blue-600 font-semibold py-2 px-4 rounded-md mb-3 text-sm transition-colors">
                        + New Request
                    </button>
                    @if (!Requests.Any())
                    {
                        <p class="text-gray-400 text-sm text-center py-4">No requests yet.</p>
                    }
                    @foreach (var req in Requests)
                    {
                        <button @key="req.Id" @onclick="() => SelectRequest(req)"
                        class="w-full text-left p-2 rounded hover:bg-gray-700 cursor-pointer text-sm text-gray-300 block truncate @(SelectedRequest?.Id == req.Id ? "endpoint-item-active" : "")">
                            <span class="font-medium text-xs @(GetMethodClass(req.Method))">@req.Method</span> @req.Name
                        </button>
                    }
                </div>
            }
        </aside>

        @if (SelectedRequest != null)
        {
            <main class="flex-1 flex flex-col p-4 bg-gray-900 overflow-y-auto">
                <div class="flex items-center space-x-2 mb-4">
                    <select @bind="SelectedRequest.Method" class="p-2 border border-gray-700 rounded-md bg-gray-800  focus:ring-blue-500 focus:border-blue-500 w-32">
                        <option value="GET">GET</option>
                        <option value="POST">POST</option>
                        <option value="PUT">PUT</option>
                        <option value="DELETE">DELETE</option>
                        <option value="PATCH">PATCH</option>
                        <option value="HEAD">HEAD</option>
                        <option value="OPTIONS">OPTIONS</option>
                    </select>
                    <input @bind="SelectedRequest.Url" type="text" placeholder="Enter request URL" class="flex-1 p-2 border border-gray-700 rounded-md bg-gray-800  focus:ring-blue-500 focus:border-blue-500" />
                    <button @onclick="SendRequestAsync" disabled="@IsSending" class="btn-primary">
                        @(IsSending ? "Sending..." : "Send")
                    </button>
                    <button @onclick="SaveCurrentRequestToCollection" class="btn-secondary">Save to Collection</button>
                </div>
                <div class="form-group form-group-inline mb-3">
                    <label for="requestName" class="text-sm font-medium text-gray-400 mr-2">Name:</label>
                    <input id="requestName" @bind="SelectedRequest.Name" placeholder="Request Name (e.g., Get Users)" class="input-field flex-grow bg-gray-800 border-gray-700" />
                </div>


                <div class="flex border-b border-gray-700 mb-4">
                    <button @onclick="() => ActiveRequestTab = RequestTab.Params" class="p-3 text-sm font-medium hover:text-blue-400 focus:outline-none @(ActiveRequestTab == RequestTab.Params ? "tab-active" : "text-gray-400")">Params</button>
                    <button @onclick="() => ActiveRequestTab = RequestTab.Headers" class="p-3 text-sm font-medium hover:text-blue-400 focus:outline-none @(ActiveRequestTab == RequestTab.Headers ? "tab-active" : "text-gray-400")">Headers</button>
                    <button @onclick="() => ActiveRequestTab = RequestTab.Body" class="p-3 text-sm font-medium hover:text-blue-400 focus:outline-none @(ActiveRequestTab == RequestTab.Body ? "tab-active" : "text-gray-400")">Body</button>
                </div>

                <div class="flex-1 overflow-y-auto">
                    @if (ActiveRequestTab == RequestTab.Params)
                    {
                        <div id="params-content" class="space-y-2">
                            @foreach (var item in SelectedRequest.Params)
                            {
                                <div @key="item.Id" class="flex space-x-2 items-center dynamic-row">
                                    <input @bind="item.Key" placeholder="Key" class="flex-1 param-key" />
                                    <input @bind="item.Value" placeholder="Value" class="flex-1 param-value" />
                                    <button class="btn-danger" @onclick="() => RemoveParamRow(item)">Remove</button>
                                </div>
                            }
                            <button class="btn-secondary text-sm mt-2" @onclick="AddParamRow">Add Param</button>
                        </div>
                    }
                    @if (ActiveRequestTab == RequestTab.Headers)
                    {
                        <div id="headers-content" class="space-y-2">
                            @foreach (var item in SelectedRequest.Headers)
                            {
                                <div @key="item.Id" class="flex space-x-2 items-center dynamic-row">
                                    <input @bind="item.Key" placeholder="Header" class="flex-1 header-key" />
                                    <input @bind="item.Value" placeholder="Value" class="flex-1 header-value" />
                                    <button class="btn-danger" @onclick="() => RemoveHeaderRow(item)">Remove</button>
                                </div>
                            }
                            <button class="btn-secondary text-sm mt-2" @onclick="AddHeaderRow">Add Header</button>
                        </div>
                    }
                    @if (ActiveRequestTab == RequestTab.Body)
                    {
                        <div id="body-content" class="h-full">
                            <div class="mb-2">
                                <label class="mr-2 text-sm">
                                    <input type="radio" name="bodyType" value="raw" @onchange="@(() => SelectedRequest.RequestBodyType = raw)" checked="@(SelectedRequest.RequestBodyType == "raw")" /> Raw
                                </label>
                                <label class="mr-2 text-sm">
                                    <input type="radio" name="bodyType" value="json" @onchange="@(() => SelectedRequest.RequestBodyType = json)" checked="@(SelectedRequest.RequestBodyType == "json")" /> JSON
                                </label>
                            </div>
                            <textarea @bind="SelectedRequest.RequestBody" @bind:event="oninput" class="w-full h-48 p-2 border border-gray-700 rounded-md bg-gray-800  focus:ring-blue-500 focus:border-blue-500 resize-none"
                            placeholder="@(SelectedRequest.RequestBodyType == "json" ? "Enter JSON body. Example: {\"name\": \"Test\"}" : "Enter raw request body")"></textarea>
                            @if (SelectedRequest.RequestBodyType == "json")
                            {
                                <div class="mt-2">
                                    <label for="requestContentType" class="text-sm font-medium text-gray-400 mr-2">Content-Type:</label>
                                    <input id="requestContentType" @bind="SelectedRequest.RequestContentType" placeholder="application/json; charset=utf-8" class="input-field bg-gray-800 border-gray-700 w-1/2" />
                                </div>
                            }
                            else
                            {
                                <div class="mt-2">
                                    <label for="requestContentType" class="text-sm font-medium text-gray-400 mr-2">Content-Type:</label>
                                    <input id="requestContentType" @bind="SelectedRequest.RequestContentType" placeholder="e.g., text/plain" class="input-field bg-gray-800 border-gray-700 w-1/2" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </main>
        }
        else
        {
            <main class="flex-1 flex items-center justify-center p-4 bg-gray-900">
                <p class="text-gray-500">Select or create a request to start.</p>
            </main>
        }


        <aside class="w-2/5 bg-gray-800 p-4 flex flex-col border-l border-gray-700 overflow-y-auto">
            <h2 class="text-lg font-semibold mb-2 ">Response</h2>
            @if (SelectedRequest != null && (SelectedRequest.ResponseStatusCode != null || IsSending || LastError != null))
            {
                <div class="flex items-center space-x-4 mb-3 text-sm">
                    <span class="text-gray-300">
                        Status:
                        <span class="font-mono px-2 py-1 rounded @(SelectedRequest.ResponseStatusCode.HasValue ? (SelectedRequest.ResponseStatusCode >= 200 && SelectedRequest.ResponseStatusCode < 300 ? "bg-green-700 text-green-100" : "bg-red-700 text-red-100") : "bg-gray-700")">
                            @(SelectedRequest.ResponseStatusCode?.ToString() ?? "---")
                        </span>
                    </span>
                    <span class="text-gray-300">Time: <span class="font-mono px-2 py-1 bg-gray-700 rounded">@(SelectedRequest.ResponseTimeMs?.ToString() ?? "---") ms</span></span>
                </div>

                @if (LastError != null)
                {
                    <div class="bg-red-900 border border-red-700 text-red-200 px-3 py-2 rounded-md mb-3 text-sm">
                        <strong>Error:</strong> @LastError
                    </div>
                }

                <div class="flex border-b border-gray-600 mb-3">
                    <button @onclick="() => ActiveResponseTab = ResponseTab.Pretty" class="p-2 text-xs font-medium hover:text-blue-400 focus:outline-none @(ActiveResponseTab == ResponseTab.Pretty ? "tab-active" : "text-gray-400")">Pretty</button>
                    <button @onclick="() => ActiveResponseTab = ResponseTab.Raw" class="p-2 text-xs font-medium hover:text-blue-400 focus:outline-none @(ActiveResponseTab == ResponseTab.Raw ? "tab-active" : "text-gray-400")">Raw</button>
                    <button @onclick="() => ActiveResponseTab = ResponseTab.Preview" class="p-2 text-xs font-medium hover:text-blue-400 focus:outline-none @(ActiveResponseTab == ResponseTab.Preview ? "tab-active" : "text-gray-400")">Preview</button>
                    <button @onclick="() => ActiveResponseTab = ResponseTab.Headers" class="p-2 text-xs font-medium hover:text-blue-400 focus:outline-none @(ActiveResponseTab == ResponseTab.Headers ? "tab-active" : "text-gray-400")">Headers</button>
                </div>

                <div class="flex-1 bg-gray-900 rounded overflow-auto text-xs">
                    @if (ActiveResponseTab == ResponseTab.Pretty)
                    {
                        <pre id="responseBodyPretty" class="p-3 whitespace-pre-wrap break-all"><code class="language-@GetLanguage(SelectedRequest.ResponseContentType)">@FormattedResponseBody</code></pre>
                    }
                    @if (ActiveResponseTab == ResponseTab.Raw)
                    {
                        <pre class="p-3 whitespace-pre-wrap break-all">@SelectedRequest.ResponseBody</pre>
                    }
                    @if (ActiveResponseTab == ResponseTab.Preview)
                    {
                        @if (SelectedRequest.ResponseContentType != null && SelectedRequest.ResponseContentType.Contains("text/html"))
                        {
                            <iframe srcdoc="@SelectedRequest.ResponseBody" class="w-full h-full border-0 rounded bg-white"></iframe>
                        }
                        else
                        {
                            <p class="p-3 text-gray-400">Preview is not available for this content type.</p>
                        }
                    }
                    @if (ActiveResponseTab == ResponseTab.Headers)
                    {
                        @if (SelectedRequest.ResponseHeaders?.Any() == true)
                        {
                            <dl class="p-3 response-headers-list">
                                @foreach (var header in SelectedRequest.ResponseHeaders)
                                {
                                    <dt class="font-semibold text-gray-300">@header.Key</dt>
                                    @foreach (var value in header.Value)
                                    {
                                        <dd class="ml-4 text-gray-400">@value</dd>
                                    }
                                }
                            </dl>
                        }
                        else
                        {
                            <p class="p-3 text-gray-400">No headers to display.</p>
                        }
                    }
                </div>
            }
            else
            {
                <div class="flex-1 flex items-center justify-center">
                    <p class="text-gray-500 text-sm">Send a request to see the response.</p>
                </div>
            }
        </aside>
    </div>
</div>

<style>
