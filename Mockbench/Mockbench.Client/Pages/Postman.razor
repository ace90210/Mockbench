@code {
    private List<ApiRequestItem> Requests { get; set; } = new List<ApiRequestItem>();
    private ApiRequestItem? SelectedRequest { get; set; }
    private bool IsSending { get; set; } = false;
    private string? LastError { get; set; }
    private string FormattedResponseBody { get; set; } = "";
    private HttpClient HttpClient;

    private LeftSidebarTab ActiveLeftSidebarTab { get; set; } = LeftSidebarTab.Endpoints;
    private RequestTab ActiveRequestTab { get; set; } = RequestTab.Params;
    private ResponseTab ActiveResponseTab { get; set; } = ResponseTab.Pretty;

    public enum LeftSidebarTab { Microservices, Endpoints }
    public enum RequestTab { Params, Headers, Body }
    public enum ResponseTab { Pretty, Raw, Preview, Headers }

    private string raw => "raw";
    private string json => "json";

    protected override void OnInitialized()
    {
        HttpClient = HttpClientFactory.CreateClient("DefaultClient"); // Ensure "DefaultClient" is configured in Program.cs or similar

        // Load initial/sample requests
        if (!Requests.Any())
        {
            Requests.AddRange(new List<ApiRequestItem>
            {
                new ApiRequestItem { Name = "Get All Posts", Url = "https://jsonplaceholder.typicode.com/posts", Method = "GET" },
                new ApiRequestItem { Name = "Get Post 1", Url = "https://jsonplaceholder.typicode.com/posts/1", Method = "GET" },
                new ApiRequestItem { Name = "Create Post", Url = "https://jsonplaceholder.typicode.com/posts", Method = "POST", RequestBody = "{\n  \"title\": \"My New Post\",\n  \"body\": \"This is the content.\",\n  \"userId\": 1\n}", RequestBodyType = "json", RequestContentType = "application/json; charset=UTF-8" },
                new ApiRequestItem { Name = "Update Post 1", Url = "https://jsonplaceholder.typicode.com/posts/1", Method = "PUT", RequestBody = "{\n  \"id\": 1,\n  \"title\": \"Updated Post Title\",\n  \"body\": \"Updated content here.\",\n  \"userId\": 1\n}", RequestBodyType = "json", RequestContentType = "application/json; charset=UTF-8" },
                new ApiRequestItem { Name = "Delete Post 1", Url = "https://jsonplaceholder.typicode.com/posts/1", Method = "DELETE" }
            });
        }

        if (Requests.Any() && SelectedRequest == null)
        {
            SelectRequest(Requests.First());
        }
    }

    private void SwitchLeftSidebarTab(LeftSidebarTab tab) => ActiveLeftSidebarTab = tab;

    private void AddNewRequest()
    {
        var newReq = new ApiRequestItem { Name = $"New Request {Requests.Count + 1}" };
        Requests.Add(newReq);
        SelectRequest(newReq);
        ActiveLeftSidebarTab = LeftSidebarTab.Endpoints; // Ensure endpoints tab is active
    }

    private void SelectRequest(ApiRequestItem request)
    {
        SelectedRequest = request;
        LastError = null;
        ActiveRequestTab = RequestTab.Params; // Default to params view
        ActiveResponseTab = ResponseTab.Pretty; // Default to pretty view
        FormattedResponseBody = ""; // Clear previous formatted response
        // If there's an existing response body for this request, format it
        if (!string.IsNullOrWhiteSpace(SelectedRequest?.ResponseBody))
        {
            FormatAndHighlightResponse();
        }
    }

    private void SaveCurrentRequestToCollection()
    {
        if (SelectedRequest == null) return;
        // Since SelectedRequest is a reference to an item in the Requests list,
        // changes made via @bind are already reflected in that item.
        // This function could be used for more complex save logic, e.g., persisting to LocalStorage.
        // For now, it's more of a conceptual placeholder or for triggering a re-render if needed.
        Console.WriteLine($"Request '{SelectedRequest.Name}' state is up-to-date in the collection.");
        StateHasChanged(); // Ensure UI reflects any bound changes if not automatic
    }

    // Methods for Params
    private void AddParamRow() => SelectedRequest?.Params.Add(new KeyValueItem());
    private void RemoveParamRow(KeyValueItem item) => SelectedRequest?.Params.Remove(item);

    // Methods for Headers
    private void AddHeaderRow() => SelectedRequest?.Headers.Add(new KeyValueItem { Key = SelectedRequest?.Headers.Count == 0 && (SelectedRequest.RequestBodyType == "json" || !string.IsNullOrEmpty(SelectedRequest.RequestBody)) ? "Content-Type" : "", Value = SelectedRequest?.Headers.Count == 0 && SelectedRequest.RequestBodyType == "json" ? "application/json; charset=UTF-8" : "" });
    private void RemoveHeaderRow(KeyValueItem item) => SelectedRequest?.Headers.Remove(item);


    private async Task SendRequestAsync()
    {
        if (SelectedRequest == null || string.IsNullOrWhiteSpace(SelectedRequest.Url))
        {
            LastError = "Request URL cannot be empty.";
            return;
        }

        IsSending = true;
        LastError = null;
        SelectedRequest.ResponseBody = null;
        SelectedRequest.ResponseStatusCode = null;
        SelectedRequest.ResponseHeaders = null;
        SelectedRequest.ResponseContentType = null;
        SelectedRequest.ResponseTimeMs = null;
        FormattedResponseBody = "";
        StateHasChanged();

        try
        {
            var requestMessage = new HttpRequestMessage(new HttpMethod(SelectedRequest.Method), SelectedRequest.Url);

            // Add Headers from UI
            foreach (var headerItem in SelectedRequest.Headers.Where(h => !string.IsNullOrWhiteSpace(h.Key)))
            {
                requestMessage.Headers.TryAddWithoutValidation(headerItem.Key, headerItem.Value);
            }

            // Add Query Params for GET, HEAD, DELETE, OPTIONS
            var finalUrl = SelectedRequest.Url;
            if (SelectedRequest.Params.Any(p => !string.IsNullOrWhiteSpace(p.Key)) &&
                (SelectedRequest.Method == "GET" || SelectedRequest.Method == "HEAD" || SelectedRequest.Method == "DELETE" || SelectedRequest.Method == "OPTIONS"))
            {
                var queryParams = "test"; //Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(finalUrl).Query);
                // foreach (var param in SelectedRequest.Params.Where(p => !string.IsNullOrWhiteSpace(p.Key)))
                // {
                //     queryParams["test"] = param.Value;
                // }
                var uriBuilder = new UriBuilder(finalUrl)
                {
                    //Query = string.Join("&", queryParams.SelectMany(kvp => kvp.Value.Select(v => $"{Uri.EscapeDataString(kvp.Key)}={Uri.EscapeDataString(v)}")))
                };
                finalUrl = uriBuilder.ToString();
                requestMessage.RequestUri = new Uri(finalUrl); // Update RequestUri with params
            }

            SendRequestMessage(requestMessage);

            var stopwatch = System.Diagnostics.Stopwatch.StartNew();
            var response = await HttpClient.SendAsync(requestMessage);
            stopwatch.Stop();

            SelectedRequest.ResponseTimeMs = stopwatch.ElapsedMilliseconds;
            SelectedRequest.ResponseStatusCode = (int)response.StatusCode;
            SelectedRequest.ResponseBody = await response.Content.ReadAsStringAsync();
            SelectedRequest.ResponseContentType = response.Content.Headers.ContentType?.ToString();

            SelectedRequest.ResponseHeaders = response.Headers.ToDictionary(h => h.Key, h => h.Value.ToList());
            if (response.Content.Headers.Any())
            {
                foreach (var header in response.Content.Headers)
                {
                    if (!SelectedRequest.ResponseHeaders.ContainsKey(header.Key))
                    {
                        SelectedRequest.ResponseHeaders.Add(header.Key, header.Value.ToList());
                    }
                    else
                    {
                        SelectedRequest.ResponseHeaders[header.Key].AddRange(header.Value);
                    }
                }
            }
            FormatAndHighlightResponse();
        }
        catch (HttpRequestException e)
        {
            LastError = $"Request Error: {e.Message}";
            SelectedRequest.ResponseBody = e.ToString();
        }
        catch (Exception e)
        {
            LastError = $"An unexpected error occurred: {e.Message}";
            SelectedRequest.ResponseBody = e.ToString();
        }
        finally
        {
            IsSending = false;
        }
    }

    private async void FormatAndHighlightResponse()
    {
        if (SelectedRequest == null || string.IsNullOrWhiteSpace(SelectedRequest.ResponseBody))
        {
            FormattedResponseBody = string.Empty;
            StateHasChanged();
            return;
        }

        string lang = GetLanguage(SelectedRequest.ResponseContentType);

        if (lang == "json" && ActiveResponseTab == ResponseTab.Pretty)
        {
            try
            {
                FormattedResponseBody = await JSRuntime.InvokeAsync<string>("appInterops.prettyPrintJson", SelectedRequest.ResponseBody);
            }
            catch
            {
                FormattedResponseBody = SelectedRequest.ResponseBody; // Fallback
            }
        }
        else if (lang == "xml" && ActiveResponseTab == ResponseTab.Pretty)
        {
            try
            {
                var xdoc = System.Xml.Linq.XDocument.Parse(SelectedRequest.ResponseBody);
                FormattedResponseBody = xdoc.ToString();
            }
            catch { FormattedResponseBody = SelectedRequest.ResponseBody; } // Fallback
        }
        else
        {
            FormattedResponseBody = SelectedRequest.ResponseBody;
        }

        StateHasChanged();

        if (ActiveResponseTab == ResponseTab.Pretty && !string.IsNullOrWhiteSpace(FormattedResponseBody))
        {
            // Debounce or ensure this is called after DOM update.
            // Using Task.Delay as a simple mechanism for this example.
            await Task.Delay(50);
            await JSRuntime.InvokeVoidAsync("appInterops.highlightElement", "responseBodyPretty", lang);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // This is a more reliable place for JS interop calls that depend on DOM elements being rendered.
        if (!firstRender && ActiveResponseTab == ResponseTab.Pretty && SelectedRequest?.ResponseBody != null && !string.IsNullOrWhiteSpace(FormattedResponseBody))
        {
            // string lang = GetLanguage(SelectedRequest.ResponseContentType);
            // await JSRuntime.InvokeVoidAsync("appInterops.highlightElement", "responseBodyPretty", lang);
            // The call is already in FormatAndHighlightResponse, which is called when view changes or data loads.
            // A more sophisticated approach might involve a flag or versioning to avoid redundant calls.
        }
    }

    private void SetResponseView(ResponseTab view) // Changed from string to enum
    {
        ActiveResponseTab = view;
        FormatAndHighlightResponse();
    }

    private string GetLanguage(string? contentType)
    {
        if (string.IsNullOrWhiteSpace(contentType)) return "plaintext";
        if (contentType.Contains("json")) return "json";
        if (contentType.Contains("xml")) return "xml";
        if (contentType.Contains("html")) return "html";
        return "plaintext";
    }

    private string GetMethodClass(string method)
    {
        return method.ToLower() switch
        {
            "get" => "method-get",
            "post" => "method-post",
            "put" => "method-put",
            "delete" => "method-delete",
            "patch" => "method-patch",
            "options" => "method-options",
            "head" => "method-head",
            _ => "text-gray-400"
        };
    }

    // Define ApiRequestItem and KeyValueItem classes
    public class ApiRequestItem
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Name { get; set; } = "New Request";
        public string Method { get; set; } = "GET";
        public string Url { get; set; } = "";
        public List<KeyValueItem> Params { get; set; } = new List<KeyValueItem>();
        public List<KeyValueItem> Headers { get; set; } = new List<KeyValueItem>();
        public string RequestBody { get; set; } = "";
        public string RequestBodyType { get; set; } = "raw"; // "raw", "json"
        public string RequestContentType { get; set; } = "";

        public int? ResponseStatusCode { get; set; }
        public string? ResponseBody { get; set; }
        public string? ResponseContentType { get; set; }
        public Dictionary<string, List<string>>? ResponseHeaders { get; set; }
        public long? ResponseTimeMs { get; set; }
    }

    public class KeyValueItem
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private void SendRequestMessage(HttpRequestMessage requestMessage)
    {
        if (!string.IsNullOrWhiteSpace(SelectedRequest.RequestBody) &&
                (SelectedRequest.Method == "POST" || SelectedRequest.Method == "PUT" || SelectedRequest.Method == "PATCH"))
        {
            string fullContentTypeInput = SelectedRequest.RequestContentType;
            string baseMediaTypeForConstructor;
            System.Text.Encoding encodingForConstructor = System.Text.Encoding.UTF8; // Default

            if (string.IsNullOrWhiteSpace(fullContentTypeInput))
            {
                // If user didn't specify a content type, infer it
                if (SelectedRequest.RequestBodyType == "json")
                {
                    baseMediaTypeForConstructor = "application/json";
                    // encodingForConstructor remains UTF8 by default
                }
                else
                {
                    baseMediaTypeForConstructor = "text/plain";
                    // encodingForConstructor remains UTF8 by default
                }
            }
            else
            {
                // User provided a content type, try to parse it
                try
                {
                    System.Net.Http.Headers.MediaTypeHeaderValue parsedHeader = System.Net.Http.Headers.MediaTypeHeaderValue.Parse(fullContentTypeInput);
                    baseMediaTypeForConstructor = parsedHeader.MediaType; // Extracts "application/json" from "application/json; charset=utf-8"

                    if (!string.IsNullOrWhiteSpace(parsedHeader.CharSet))
                    {
                        try
                        {
                            encodingForConstructor = System.Text.Encoding.GetEncoding(parsedHeader.CharSet);
                        }
                        catch (ArgumentException)
                        {
                            // Invalid charset specified by user, fall back to UTF-8
                            encodingForConstructor = System.Text.Encoding.UTF8;
                            // Optionally, you might want to inform the user or log this
                        }
                    }
                    // If no charset in parsedHeader, encodingForConstructor remains the default (UTF8)
                }
                catch (FormatException)
                {
                    // The user-provided content type string is malformed.
                    // Fallback to a sensible default or handle error.
                    // For simplicity, let's fallback based on RequestBodyType here.
                    LastError = $"Invalid Content-Type format: '{fullContentTypeInput}'. Defaulting based on body type.";
                    if (SelectedRequest.RequestBodyType == "json")
                    {
                        baseMediaTypeForConstructor = "application/json";
                    }
                    else
                    {
                        baseMediaTypeForConstructor = "text/plain";
                    }
                    encodingForConstructor = System.Text.Encoding.UTF8;
                }
            }

            requestMessage.Content = new StringContent(SelectedRequest.RequestBody, encodingForConstructor, baseMediaTypeForConstructor);
        }
    }
}
